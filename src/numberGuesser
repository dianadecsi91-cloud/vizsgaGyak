  export class ToDo {
    content: string = ""
    priority: boolean = false
    done: boolean = false
    timeStamp: Date = new Date()

    constructor(content: string = "", done: boolean = false) {
        this.content = content
        this.done = done
        // if (this.content.startsWith('!')) this.priority = true
    }
}
add(): void {
    if (this.newTodo.content.startsWith('!')) {
      this.newTodo.priority = true
      this.newTodo.content = this.newTodo.content.slice(1)
    }
    this.todos.unshift({ ...this.newTodo })
    this.newTodo.content = ""
    this.newTodo.priority = false
  }
  <input class="form-control mb-2" type="text" placeholder="To do this..." [(ngModel)]="newTodo.content">
  <button class="btn btn-sm btn-primary me-3" (click)="add()">Add Todo</button>
  <button class="btn btn-sm btn-success me-3" (click)="save()">Save</button>
  <button class="btn btn-sm btn-warning me-3" (click)="load()">Load</button>
  <hr>
  <div>
    Total: <span class="badge rounded-pill text-bg-primary me-3">{{ todos.length }}</span>
    Finished: <span class="badge rounded-pill text-bg-success me-3">{{ countFinishedTodos() }}</span>
    Missing: <span class="badge rounded-pill text-bg-warning">{{ todos.length - countFinishedTodos() }}</span>
  </div>
  <hr>
  <div *ngFor="let item of todos" (click)="markTodoAsDone(item)"
    [ngClass]="{
      'border-priority': item.priority,
      'alert': true,
      'alert-success': item.done,
      'alert-secondary': !item.done
    }"
  >
    <div class="row">
      <div class="col-2">
        <span class="badge rounded-pill text-bg-light">
          {{ formatDate(item.timeStamp) }}
        </span>
      </div>
      <div class="col" [ngClass]="{'done-icon': item.done}">
        {{ item.content }}
      </div>
    </div>
  </div>
</div>


