  guesses: GameItem[] = []
  tip: number = 0
  endOfGame: boolean = false
  tipCounter: number = 0

  getRandomInteger(min: number, max: number): number {
    return Math.floor(Math.random() * (max - min + 1)) + min
  }

  getTipClass(gameItem: GameItem): string {
    if (gameItem.response.includes("VÉGE")) return "alert alert-success"
    else return "alert alert-danger"

    // return gameItem.response.includes("VÉGE") ? "goodTip" : "badTip"

    // if (gameItem.response.includes("VÉGE")) {
    //   return "goodTip"
    // } else {
    //   return "badTip"
    // }
  }

  check(): void {
    this.tipCounter++
    if ( this.tip ==this.generatedNumber) {
      // játék vége
      this.guesses.push(new GameItem(this.tip, "JÁTÉK VÉGE"))
      this.endOfGame = true
    } else if (this.tip >this.generatedNumber ) {
      // nagyobbra gondoltam
      this.guesses.push(new GameItem(this.tip, "NAGYOBBRA GONDOLTAM"))
    } else {
      // kisebbre gondoltam
      this.guesses.push(new GameItem(this.tip, "KISEBBRE GONDOLTAM"))
    }
  }
export class GameItem {
    guess: number = 0
    response: string = ""

    constructor(guess: number, response: string) {
        this.guess = guess
        this.response = response
    }
}
html: 
<h1>Number Guesser App</h1>
  <div *ngIf="!endOfGame">
    <input class="form-control" type="number" placeholder="Your tip..." [(ngModel)]="tip">
    <br>
    <button class="btn btn-primary" (click)="check()">Check</button>
  </div>
  <div *ngIf="endOfGame">
    <h3><span class="badge text-bg-primary">{{ tipCounter }}</span> lépésben kitaláltad!</h3>
  </div>
  <hr>
  <!-- <p *ngFor="let item of guesses" [ngClass]="item.response.includes('VÉGE') ? 'goodTip' : 'badTip'">
    [{{ item.guess }}] &rarr; {{ item.response }}
  </p> -->

  <p *ngFor="let item of guesses" [ngClass]="getTipClass(item)" class="tip-result">
    [{{ item.guess }}] &rarr; {{ item.response }}
  </p>
</div>
